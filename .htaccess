DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and directories
    RewriteRule ^(\.env|\.git|composer\.|package\.|tests|storage|database|app|bootstrap|config) - [F,L,NC]

    # Local development: redirect localhost/tools to localhost/tools/public
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{REQUEST_URI} !^/tools/public/
    RewriteRule ^(.*)$ /tools/public/$1 [L,R=302]

    # Live Server (Production): Internally rewrite all requests to public/
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

